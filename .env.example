# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored. Set these in your hosting platform
# (Firebase App Hosting) as environment variables for production.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required by the Razorpay verify callback to update orders past RLS.
# Never expose this to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Public demo (optional) ---
# Shows a one-tap "Use demo account" button on the login page, for people trying
# the app from GitHub. These ship to the browser, so use a dedicated account with
# the 'customer' role — never an admin. Leave blank to hide the button.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
