# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored. For production, set these as environment
# variables in your hosting platform. NEXT_PUBLIC_* values are baked in at build
# time, so redeploy after changing them.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required by the Razorpay verify callback to update orders past RLS.
# Never expose this to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Public demo (optional) ---
# Lets "Want to test?" on the login page sign visitors straight in for the guided
# tour (e.g. recruiters opening the project). These ship to the browser, so use a
# dedicated account with the 'customer' role — never an admin. Left blank, the
# tour still runs but asks the visitor to sign up first.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
